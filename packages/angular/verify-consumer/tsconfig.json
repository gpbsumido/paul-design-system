{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      // Resolve the library the way a consumer would — through what was built,
      // not through src/.
      "@paul-portfolio/angular": ["../dist"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["app.ts"]
}
